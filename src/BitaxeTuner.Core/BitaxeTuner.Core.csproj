<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fans/Firmware/btfan.py" LogicalName="BitaxeTuner.Core.Fans.btfan.py" />
    <!-- WithCulture=false: sonst hielte MSBuild „.en.“ für eine Kultur und legte die Datei in eine Satelliten-Assembly -->
    <EmbeddedResource Include="I18n/Strings.en.json" LogicalName="BitaxeTuner.Core.I18n.Strings.en.json" WithCulture="false" />
    <!-- DejaVu Sans Condensed (freie Lizenz, siehe Display/Fonts/LICENSE) für das E-Paper-Bild -->
    <EmbeddedResource Include="Display/Fonts/DejaVuSansCondensed.ttf" LogicalName="BitaxeTuner.Core.Display.Regular.ttf" />
    <EmbeddedResource Include="Display/Fonts/DejaVuSansCondensed-Bold.ttf" LogicalName="BitaxeTuner.Core.Display.Bold.ttf" />
    <EmbeddedResource Include="Profiles\DeviceProfiles.json" LogicalName="BitaxeTuner.Core.Profiles.DeviceProfiles.json" />
    <!-- Eingebaute Profile früherer Versionen: unveränderte Kopien in der Nutzerdatei sollen neue Werte nicht überdecken -->
    <EmbeddedResource Include="Profiles\DeviceProfiles.v0.1.0.json" LogicalName="BitaxeTuner.Core.Profiles.DeviceProfiles.v0.1.0.json" />
    <EmbeddedResource Include="Profiles\DeviceProfiles.legacy.json" LogicalName="BitaxeTuner.Core.Profiles.DeviceProfiles.legacy.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BitaxeTuner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Audit L1: ImageSharp fest auf eine Version ohne bekannte Sicherheitslücken (GHSA-rxmq-m78w-7wmc u. a., behoben in 3.1.11) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="SMBLibrary" Version="1.5.8.1" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
