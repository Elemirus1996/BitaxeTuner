<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    BitaxeTuner-Server: derselbe Motor wie die Desktop-App (MinerHub aus BitaxeTuner.Core) als Dienst –
    Windows-Dienst, systemd (Raspberry Pi / Linux) oder Docker. Bedienung per Browser oder Desktop-App.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BitaxeTuner.Server</AssemblyName>
    <RootNamespace>BitaxeTuner.Server</RootNamespace>
    <!-- de-DE-Formatierung in Meldungen und Tagesbericht: ICU wird gebraucht (im Docker-Image enthalten) -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- SQLite bringt eine native Bibliothek mit; für PublishSingleFile mit einpacken -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BitaxeTuner.Core\BitaxeTuner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web-Oberfläche liegt eingebettet in der DLL: keine losen Dateien, die ein Update vergessen könnte -->
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BitaxeTuner.Tests" />
  </ItemGroup>

</Project>
