<Window xmlns:l="clr-namespace:BitaxeTuner.App.I18n"
        x:Class="BitaxeTuner.App.Views.ServerModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{l:T 'Betriebsart'}" Height="760" Width="640" MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="ModeTitle" Style="{StaticResource Section}" Text="{l:T 'Aktuell: Lokal (dieser PC fragt die Miner ab)'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:T '„Lokal“: Die App erledigt alles selbst – nur solange dieser PC läuft. „Server“: Ein BitaxeTuner-Server (Raspberry Pi, Windows-Dienst oder Docker) übernimmt alles rund um die Uhr; die App zeigt dessen Oberfläche an und fragt selbst keine Miner ab. Es fragt immer nur eine Seite die Miner ab.'}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="Server"/>
                        <TextBlock Text="{l:T 'ADRESSE (z. B. 192.168.1.20 oder raspberrypi.local:8484)'}" Style="{StaticResource Label}"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{l:T 'Im Netz suchen'}" Click="Discover_Click" x:Name="DiscoverButton" Margin="6,0,0,0" Padding="10,4"/>
                            <ComboBox x:Name="UrlBox" IsEditable="True"/>
                        </DockPanel>
                        <TextBlock Text="{l:T 'API-TOKEN (Server-Oberfläche → Einstellungen → Desktop-App verbinden)'}" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="TokenBox" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:T 'Verbindung testen'}" Click="Test_Click" x:Name="TestButton" Padding="12,4"/>
                            <Button Content="{l:T 'Server-Oberfläche im Browser'}" Click="OpenBrowser_Click" Style="{StaticResource LinkButton}" Margin="12,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ConnectionText" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <CheckBox x:Name="PickupCheck" Margin="0,6,0,6" Click="Pickup_Changed"
                                  Content="{l:T 'Im Modus „Server“ täglich eine geprüfte Sicherung vom Server auf diesen PC holen'}"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="{l:T 'Jetzt holen'}" Click="PickupNow_Click" Margin="6,0,0,0" Padding="10,4"/>
                            <Button DockPanel.Dock="Right" Content="…" Click="PickupBrowse_Click" Margin="6,0,0,0" Padding="10,4" ToolTip="{l:T 'Ordner wählen'}"/>
                            <TextBox x:Name="PickupFolder" LostFocus="Pickup_Changed" ToolTip="{l:T 'Zielordner für die Sicherungen (die letzten 14 bleiben)'}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" x:Name="ToServerCard">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{l:T 'Auf „Server“ umschalten'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:T 'Mit Datenübertragung: Verlauf (history.db), Einstellungen, Geräte, Steuerdaten, Benchmark-Ergebnisse und Sicherungen gehen einmalig auf den Server. Vorher wird alles geprüft (SHA-256, integrity_check); hat der Server schon Daten, fragt die App nach und der Server sichert seinen Stand. Deine lokalen Daten bleiben unverändert erhalten.'}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:T 'Daten übertragen und umschalten …'}" Click="UploadAndSwitch_Click" Style="{StaticResource PrimaryButton}" Padding="12,4"/>
                            <Button Content="{l:T 'Nur umschalten'}" Click="SwitchToServer_Click" Margin="8,0,0,0" Padding="12,4"
                                    ToolTip="{l:T 'Der Server hat die Daten schon (z. B. frisch eingerichtet oder früher übertragen)'}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" x:Name="PiCard">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{l:T 'Raspberry Pi vorbereiten'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:T '1. Das BitaxeTuner-Pi-Image (Release-Seite) mit dem Raspberry Pi Imager auf die SD-Karte schreiben („Eigenes Image“ – der Imager bietet dafür keine Einstellungen an). 2. SD-Karte neu einstecken, hier das Laufwerk „bootfs“ wählen. 3. Admin-Passwort, Zugang zum Pi und WLAN eintragen, optional deine Daten mitgeben. Der Pi übernimmt beim ersten Start alles, startet pausiert und ist unter http://bitaxetuner.local:8484/ erreichbar; danach oben „Nur umschalten“.'}"/>
                        <TextBlock Text="{l:T 'SD-KARTE (BOOT-PARTITION)'}" Style="{StaticResource Label}"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{l:T 'Aktualisieren'}" Click="RefreshDrives_Click" Margin="6,0,0,0" Padding="10,4"/>
                            <ComboBox x:Name="DriveBox" DisplayMemberPath="Label"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T 'ADMIN-PASSWORT (MIND. 10 ZEICHEN)'}" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="PiPassword1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T 'WIEDERHOLEN'}" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="PiPassword2"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="PiSetupOs" IsChecked="True" Margin="0,0,0,8"
                                  Content="{l:T 'Zugang zum Pi einrichten (Benutzer, WLAN, SSH, Hostname „bitaxetuner“)'}"/>
                        <Grid x:Name="PiOsFields" Margin="0,0,0,10" IsEnabled="{Binding IsChecked, ElementName=PiSetupOs}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{l:T 'BENUTZERNAME (FÜR SSH)'}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="PiUser" Text="pi"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="{l:T 'PI-PASSWORT (MIND. 8 ZEICHEN)'}" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="PiUserPassword"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="{l:T 'WLAN-NAME (LEER = NUR LAN-KABEL)'}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="PiWifiSsid"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="{l:T 'WLAN-PASSWORT'}" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="PiWifiPassword"/>
                            </StackPanel>
                            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'LAND'}" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="PiCountry" ToolTip="{l:T 'Für die WLAN-Regeln, z. B. DE, AT, CH, US'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T 'ZEITZONE'}" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="PiTimezone" ToolTip="{l:T 'z. B. Europe/Berlin, America/New_York'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{l:T 'TASTATUR'}" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="PiKeyboard" ToolTip="{l:T 'z. B. de, us, gb, ch'}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Grid.Row="3" Grid.ColumnSpan="3" x:Name="PiSshKey" IsChecked="True" Margin="0,0,0,8"
                                      Content="{l:T 'SSH-Schlüssel dieses PCs eintragen (Anmeldung ohne Passwort)'}"/>
                            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0"
                                       Text="{l:T 'Pi 3: nur 2,4-GHz-WLAN. Passwörter landen nur als Hash auf der Karte. Land, Zeitzone und Tastatur kommen aus den Windows-Einstellungen.'}"/>
                        </Grid>
                        <CheckBox x:Name="PiIncludeData" IsChecked="True" Margin="0,0,0,10"
                                  Content="{l:T 'Meine Daten mitgeben (Geräte, Verlauf, Einstellungen, Steuerdaten, Ergebnisse)'}"/>
                        <Button Content="{l:T 'Einrichtungspaket auf die SD-Karte schreiben'}" Click="PreparePi_Click"
                                Style="{StaticResource PrimaryButton}" Padding="12,4" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" x:Name="SshCard">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{l:T 'SSH zum Pi'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:T 'Konsole auf dem Pi öffnen, ohne Passwort. Der Schlüssel dieses PCs liegt in %USERPROFILE%\\.ssh\\bitaxetuner_ed25519. Wurde er nicht schon beim Vorbereiten der SD-Karte eingetragen: einmal „Schlüssel übertragen …“ (fragt einmal das Pi-Passwort ab).'}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T 'BENUTZER'}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="SshUserBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T 'RECHNER (LEER = AUS DER SERVER-ADRESSE)'}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="SshHostBox"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:T 'SSH-Terminal öffnen'}" Click="SshOpen_Click" Style="{StaticResource PrimaryButton}" Padding="12,4"/>
                            <Button Content="{l:T 'Schlüssel übertragen …'}" Click="SshInstall_Click" Margin="8,0,0,0" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" x:Name="ToLocalCard">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{l:T 'Auf „Lokal“ umschalten'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:T 'Der Server wird dabei pausiert (er fragt keine Miner mehr ab, bis du ihn in seiner Oberfläche fortsetzt). Mit Datenübertragung übernimmt die App den kompletten Stand des Servers; der bisherige lokale Stand wird vorher gesichert.'}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:T 'Daten vom Server holen und umschalten …'}" Click="DownloadAndSwitch_Click" Style="{StaticResource PrimaryButton}" Padding="12,4"/>
                            <Button Content="{l:T 'Nur umschalten'}" Click="SwitchToLocal_Click" Margin="8,0,0,0" Padding="12,4"
                                    ToolTip="{l:T 'Mit dem lokalen Stand weiterarbeiten (was der Server seitdem gesammelt hat, bleibt nur auf dem Server)'}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{l:T 'Ablauf'}"/>
                        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:T 'Schließen'}" IsCancel="True" Click="Close_Click" Padding="14,4"/>
        </StackPanel>
    </Grid>
</Window>
