<Window xmlns:l="clr-namespace:BitaxeTuner.App.I18n"
        x:Class="BitaxeTuner.App.Views.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{l:T 'Einstellungen wiederherstellen'}" Height="520" Width="720" MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" />
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{l:T 'Sicherung:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="SnapshotBox" DisplayMemberPath="DisplayText" SelectionChanged="OnSnapshotChanged" />
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="8">
            <Grid>
                <ItemsControl x:Name="ChangeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAllowed}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Change.GroupText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Change.Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="3">
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Change.Current, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <Run Text="  →  " />
                                        <Run Text="{Binding Change.Saved, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                                               Visibility="{Binding Hint, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoChangesText" Text="{l:T 'Keine Unterschiede – der Miner hat bereits diese Einstellungen.'}"
                           Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,10"
                   Text="{l:T 'Nur markierte Felder werden gesendet. Vorher wird der aktuelle Stand automatisch gesichert. Frequenz/Spannung werden in history.db protokolliert. Bei Pool-Änderungen startet der Miner neu; Pool-Passwörter bleiben unverändert.'}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:T 'Abbrechen'}" IsCancel="True" />
            <Button x:Name="OkButton" Content="{l:T 'Wiederherstellen'}" Style="{StaticResource PrimaryButton}" Click="OnOk" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
