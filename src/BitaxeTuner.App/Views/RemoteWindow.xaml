<Window xmlns:l="clr-namespace:BitaxeTuner.App.I18n"
        x:Class="BitaxeTuner.App.Views.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{l:T 'BitaxeTuner – Server'}" Icon="/Assets/app.ico" Height="920" Width="1400" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Betriebsart und App-Updates (die Bedienung der Miner steckt in der Server-Oberfläche darunter) -->
        <Border Background="{DynamicResource HeaderBrush}" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Betriebsart: Server'}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ServerText" Foreground="#9CA3AF" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Foreground="#9CA3AF" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BackupText" Foreground="#9CA3AF" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Button x:Name="UpdateButton" Click="Update_Click" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0" Padding="10,2" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{l:T 'Neu laden'}" Click="Reload_Click" />
                    <Button Content="{l:T 'Im Browser öffnen'}" Click="OpenBrowser_Click" />
                    <Button Content="{l:T 'SSH-Terminal'}" Click="Ssh_Click"
                            ToolTip="{l:T 'Konsole auf deinem Server öffnen (ohne Passwort, Einrichtung unter Betriebsart …)'}" />
                    <Button Content="{l:T 'Betriebsart …'}" Click="Mode_Click" Style="{StaticResource PrimaryButton}" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Web" Grid.Row="1" />

        <Border x:Name="ErrorPanel" Grid.Row="1" Background="{DynamicResource WindowBrush}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="{l:T 'Server nicht erreichbar'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16"
                           Text="{l:T 'Die Miner laufen unabhängig davon weiter. Diese App fragt im Modus „Server“ bewusst keine Miner selbst ab – sonst würden sie doppelt abgefragt. Zum lokalen Betrieb: „Betriebsart …“.'}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{l:T 'Erneut versuchen'}" Click="Reload_Click" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{l:T 'Betriebsart …'}" Click="Mode_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
