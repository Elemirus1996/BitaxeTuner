<Window xmlns:l="clr-namespace:BitaxeTuner.App.I18n"
        x:Class="BitaxeTuner.App.Views.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{l:T 'BitaxeTuner – Server'}" Icon="/Assets/app.ico" Height="920" Width="1400" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile (0.9.14 wie die Browser-Oberfläche): links Server und Stand, rechts Aktionen ohne Rahmen; nur „Update“ hervorgehoben -->
        <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- 0.9.24 Mehrere Server: Umschalter (nur mit mehr als einem Server) -->
                    <ComboBox x:Name="ServerPicker" MinWidth="170" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center"
                              SelectionChanged="ServerPicker_SelectionChanged" ToolTip="{l:T 'Server wechseln'}" />
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T 'Betriebsart: Server'}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServerText" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BackupText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button x:Name="UpdateButton" Click="Update_Click" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0" Padding="12,4" Visibility="Collapsed" />
                    <Button x:Name="HttpsButton" Click="Https_Click" Margin="10,0,0,0" Padding="10,4" Visibility="Collapsed"
                            Content="{l:T 'Unverschlüsselt (HTTP) – auf HTTPS umstellen …'}"
                            ToolTip="{l:T 'Passwort, Token und Sitzung gehen im Heimnetz bisher unverschlüsselt. Mit HTTPS sind sie verschlüsselt.'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="Reload_Click" Style="{StaticResource GhostButton}" ToolTip="{l:T 'Neu laden'}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,6,0" FontSize="13" /><TextBlock Text="{l:T 'Neu laden'}" /></StackPanel>
                    </Button>
                    <Button Click="OpenBrowser_Click" Style="{StaticResource GhostButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" Margin="0,0,6,0" FontSize="13" /><TextBlock Text="{l:T 'Im Browser öffnen'}" /></StackPanel>
                    </Button>
                    <Button x:Name="BackupButton" Click="Backup_Click" Style="{StaticResource GhostButton}"
                            ToolTip="{l:T 'Sicherungen auf diesem PC: holen, Ordner öffnen, auf den Server einspielen'}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,6,0" FontSize="13" /><TextBlock Text="{l:T 'Sicherungen ▾'}" /></StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="PickupNowItem" Header="{l:T 'Jetzt eine Sicherung auf diesen PC holen'}" Click="PickupNow_Click" />
                                <MenuItem Header="{l:T 'Sicherungsordner öffnen'}" Click="OpenBackupFolder_Click" />
                                <Separator />
                                <MenuItem Header="{l:T 'Sicherung auf den Server einspielen …'}" Click="RestoreToServer_Click" />
                                <Separator />
                                <MenuItem Header="{l:T 'Einstellungen (Betriebsart …)'}" Click="Mode_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SshButton" Click="SshMenu_Click" Style="{StaticResource GhostButton}"
                            ToolTip="{l:T 'Konsole auf deinem Server öffnen (ohne Passwort, Einrichtung unter Betriebsart …)'}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" Style="{StaticResource Glyph}" Margin="0,0,6,0" FontSize="13" /><TextBlock Text="{l:T 'SSH ▾'}" /></StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T 'SSH-Terminal öffnen'}" Click="Ssh_Click" />
                                <Separator />
                                <MenuItem Header="{l:T 'Notfall-Update per SSH …'}" Click="SshUpdate_Click" />
                                <MenuItem Header="{l:T 'Systemdateien per SSH erneuern …'}" Click="SshSystem_Click" />
                                <Separator />
                                <MenuItem Header="{l:T 'Einstellungen (Betriebsart …)'}" Click="Mode_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Click="Servers_Click" Style="{StaticResource GhostButton}" ToolTip="{l:T 'Weitere Server hinzufügen oder entfernen'}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource Glyph}" Margin="0,0,6,0" FontSize="13" /><TextBlock Text="{l:T 'Server …'}" /></StackPanel>
                    </Button>
                    <Button Click="Mode_Click" Margin="6,0,0,0" Padding="10,5">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" Style="{StaticResource Glyph}" Margin="0,0,6,0" FontSize="13" /><TextBlock Text="{l:T 'Betriebsart …'}" /></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Web" Grid.Row="1" />

        <!-- 0.9.24 Alle Server: Summen und je Server eine Kachel (Klick wechselt dorthin) -->
        <ScrollViewer x:Name="AllPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource WindowBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="{l:T 'Alle Server'}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="AllTotals" FontFamily="Cascadia Mono, Consolas" FontSize="15" Margin="0,8,0,4" TextWrapping="Wrap" />
                <TextBlock x:Name="AllHint" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />
                <WrapPanel x:Name="AllTiles" />
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ErrorPanel" Grid.Row="1" Background="{DynamicResource WindowBrush}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="{l:T 'Server nicht erreichbar'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16"
                           Text="{l:T 'Die Miner laufen unabhängig davon weiter. Diese App fragt im Modus „Server“ bewusst keine Miner selbst ab – sonst würden sie doppelt abgefragt. Zum lokalen Betrieb: „Betriebsart …“.'}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{l:T 'Erneut versuchen'}" Click="Reload_Click" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{l:T 'Betriebsart …'}" Click="Mode_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
