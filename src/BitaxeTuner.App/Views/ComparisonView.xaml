<UserControl xmlns:l="clr-namespace:BitaxeTuner.App.I18n"
        x:Class="BitaxeTuner.App.Views.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="{l:T 'Aktualisieren'}" Command="{Binding RefreshCommand}" Margin="0" />
                <Button DockPanel.Dock="Right" Content="{l:T 'Bericht …'}" Click="Report_Click" Margin="0,0,8,0"
                        ToolTip="{l:T 'Miner, Werte und Diagramme wählen und als druckbare Seite öffnen'}" />
                <StackPanel>
                    <TextBlock Text="{l:T 'Miner-Vergleich'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="{l:T '24-h-Werte aus history.db (nur Online-Minuten), Verfügbarkeit über 7 Tage, Benchmark-Werte aus dem letzten Lauf je Miner. „Stabil bis“ = höchste Frequenz, die im Benchmark stabil lief – ein Maß für die Chip-Güte.'}" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox Width="200" Margin="0,0,8,0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{l:T 'Miner suchen (Name oder Chip)'}" VerticalContentAlignment="Center" />
                <ComboBox Width="220" Margin="0,0,8,0" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                          ToolTip="{l:T 'Nur dieses Modell anzeigen'}" />
                <ComboBox Width="180" Margin="0,0,8,0" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                          ToolTip="{l:T 'Nur Miner dieser Gruppe anzeigen'}" />
                <CheckBox Content="{l:T 'nur online'}" IsChecked="{Binding OnlyOnline}" VerticalAlignment="Center" />
            </WrapPanel>
            <DataGrid ItemsSource="{Binding View}" IsReadOnly="True" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T 'Miner'}" Binding="{Binding Name}" Width="110" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Chip" Binding="{Binding Chip}" Width="130" />
                    <DataGridTextColumn Header="{l:T 'Aktuell'}" Binding="{Binding Current}" Width="140" />
                    <DataGridTextColumn Header="{l:T 'Ø Hash 24 h'}" Binding="{Binding Hash24Text}" Width="Auto" SortMemberPath="Hash24" />
                    <DataGridTextColumn Header="{l:T 'Ø J/TH 24 h'}" Binding="{Binding Eff24Text}" Width="Auto" SortMemberPath="Eff24" />
                    <DataGridTextColumn Header="{l:T 'Ø Temp 24 h'}" Binding="{Binding Temp24Text}" Width="Auto" SortMemberPath="Temp24" />
                    <DataGridTextColumn Header="{l:T 'Verfügbar 7 T'}" Binding="{Binding AvailabilityText}" Width="Auto" SortMemberPath="Availability7" />
                    <DataGridTextColumn Header="{l:T 'Pool-Difficulty'}" Binding="{Binding PoolDiff}" Width="Auto" />
                    <DataGridTextColumn Header="{l:T 'Stabil bis'}" Binding="{Binding MaxStableText}" Width="Auto" SortMemberPath="MaxStableFrequency" />
                    <DataGridTextColumn Header="{l:T 'Beste Hashrate (Benchmark)'}" Binding="{Binding BestHash}" Width="270" />
                    <DataGridTextColumn Header="{l:T 'Beste Effizienz (Benchmark)'}" Binding="{Binding BestEff}" Width="270" />
                    <DataGridTextColumn Header="Benchmark" Binding="{Binding Benchmark}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
