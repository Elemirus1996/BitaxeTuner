<!-- Dunkles Design (Farben aus BitaxeMonitor). Gleiche Schlüssel wie Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#0F1216" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#0B0E12" />
    <SolidColorBrush x:Key="CardBrush" Color="#171C24" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#242C38" />
    <SolidColorBrush x:Key="FieldBrush" Color="#1E242E" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1E242E" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#2A3444" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#2A3444" />
    <SolidColorBrush x:Key="AltRowBrush" Color="#1B2029" />
    <SolidColorBrush x:Key="TextBrush" Color="#E9EEF6" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7C879B" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9FB3D1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F7931A" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#F7A94A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2418" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D95B5B" />
    <SolidColorBrush x:Key="OkBrush" Color="#4EC9A0" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E0B44A" />
    <SolidColorBrush x:Key="InfoBrush" Color="#6E9FE8" />
    <SolidColorBrush x:Key="IdleBrush" Color="#5A6478" />
    <SolidColorBrush x:Key="SaveBrush" Color="#2F6B55" />
    <SolidColorBrush x:Key="TempBrush" Color="#6E9FE8" />
    <SolidColorBrush x:Key="MarkerBrush" Color="#F7931A" />

    <!-- Diagrammfarben -->
    <Color x:Key="ChartHashColor">#4EC9A0</Color>
    <Color x:Key="ChartTempColor">#E0B44A</Color>
    <Color x:Key="ChartPowerColor">#6E9FE8</Color>
    <Color x:Key="ChartEffColor">#C58BE8</Color>
</ResourceDictionary>
