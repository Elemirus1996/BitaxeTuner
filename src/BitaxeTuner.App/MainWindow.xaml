<Window x:Class="BitaxeTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BitaxeTuner.App.ViewModels"
        xmlns:controls="clr-namespace:BitaxeTuner.App.Controls"
        Title="BitaxeTuner" Icon="Assets/app.ico" Height="860" Width="1360" MinWidth="1000" MinHeight="640"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Background="#111827" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                        <TextBlock Text="₿" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BitaxeTuner" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VersionText}" Foreground="#9CA3AF" Margin="8,4,0,0" VerticalAlignment="Center" />
                    <Button Content="{Binding UpdateText}" Command="{Binding OpenUpdateCommand}" Style="{StaticResource LinkButton}"
                            Foreground="{StaticResource AccentBrush}" Margin="14,4,0,0" VerticalAlignment="Center"
                            Visibility="{Binding UpdateText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Profile bearbeiten" Command="{Binding EditProfilesCommand}" />
                    <Button Content="Datenordner …" Command="{Binding ChooseDataDirectoryCommand}" ToolTip="{Binding DataDirectory}" />
                    <Button Content="Ordner öffnen" Command="{Binding OpenDataDirectoryCommand}" />
                    <Button Content="GitHub" Command="{Binding OpenProjectPageCommand}" />
                    <Button Content="■ Alle stoppen" Command="{Binding StopAllCommand}" Style="{StaticResource DangerButton}" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Geräteliste -->
            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Geräte" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddDeviceCommand}" Margin="6,0,0,0" Width="34"
                                    Style="{StaticResource PrimaryButton}" IsDefault="True" ToolTip="Gerät hinzufügen" />
                            <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP-Adresse oder Hostname, z. B. 192.168.1.50 – oder „sim“ für eine Simulation" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="IP-Adresse eingeben (z. B. 192.168.1.50). Zum Ausprobieren: sim oder sim:nerdqaxe-plusplus" />
                        <Button Content="Netzwerk durchsuchen" Command="{Binding ScanNetworkCommand}" Margin="0,0,0,6" />
                        <ProgressBar Value="{Binding ScanProgress}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="Ausgewähltes Gerät entfernen" Command="{Binding RemoveDeviceCommand}" Margin="0,8,0,0" />
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                                <Grid Margin="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top"
                                             Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="● läuft" Foreground="{StaticResource AccentDarkBrush}" FontWeight="SemiBold"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Profile.Name}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Hinweis ohne Gerät -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"
                    Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="Willkommen bei BitaxeTuner" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="14" LineHeight="22"
                               Text="Füge links einen Miner per IP-Adresse hinzu oder durchsuche das Netzwerk. Unterstützt werden Bitaxe (Max, Ultra, Supra, Gamma, Duo, GT, Hex, SupraHex) mit AxeOS sowie NerdAxe, NerdAxe Gamma, NerdQAxe+/++ und NerdOctaxe. Der Benchmark erhöht Frequenz und Spannung Schritt für Schritt, misst jede Kombination und zeigt dir die beste Einstellung." />
                </StackPanel>
            </Border>

            <!-- Gerätedetails -->
            <Grid Grid.Column="2" DataContext="{Binding SelectedDevice}"
                  Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Profil:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding Profile}" Width="260"
                                      DisplayMemberPath="Name" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                            <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" />
                            <Button Content="Weboberfläche" Command="{Binding OpenWebUiCommand}" Margin="0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding ProfileNotes}" Foreground="{StaticResource AccentDarkBrush}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding ProfileNotes, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" Padding="14">
                    <!-- LIVE -->
                    <TabItem Header="Live">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <UniformGrid Columns="4">
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="Hashrate" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Info.HashRateGh, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" GH/s" FontSize="13" /></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="erwartet " /><Run Text="{Binding Info.ExpectedHashRateGh, Converter={StaticResource Num}, ConverterParameter=F0, Mode=OneWay}" /><Run Text=" GH/s" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="Leistung / Effizienz" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Info.PowerW, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" W" FontSize="13" /></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding EfficiencyText, Mode=OneWay}" /><Run Text=" J/TH" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="Chip / VR-Temperatur" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Info.MaxChipTempC, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" °C" FontSize="13" /></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="VR " /><Run Text="{Binding Info.VrTempC, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" °C" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}" Margin="0,0,0,10"><StackPanel>
                                        <TextBlock Text="Frequenz / Kernspannung" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Info.FrequencyMhz, Mode=OneWay}" /><Run Text=" MHz" FontSize="13" /></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Info.CoreVoltageMv, Mode=OneWay}" /><Run Text=" mV (ist " /><Run Text="{Binding Info.CoreVoltageActualMv, Converter={StaticResource Num}, ConverterParameter=F0, Mode=OneWay}" /><Run Text=" mV)" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="Eingangsspannung" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Info.InputVoltageMv, Converter={StaticResource Num}, ConverterParameter=F0, Mode=OneWay}" /><Run Text=" mV" FontSize="12" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="Lüfter" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Info.FanPercent, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" % · " FontSize="12" /><Run Text="{Binding Info.FanRpm, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" U/min" FontSize="12" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="Shares (akzeptiert / abgelehnt)" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Info.SharesAccepted, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Info.SharesRejected, Mode=OneWay}" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}" Margin="0,0,0,10"><StackPanel>
                                        <TextBlock Text="Fehlerrate (ASIC)" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Info.ErrorPercent, Converter={StaticResource Num}, ConverterParameter=F2, Mode=OneWay}" /><Run Text=" %" FontSize="12" /></TextBlock>
                                    </StackPanel></Border>
                                </UniformGrid>
                                <Border Style="{StaticResource Card}">
                                    <controls:LineChart Values="{Binding HashHistory}" Title="Hashrate" Unit="GH/s" Height="200" Stroke="{StaticResource AccentBrush}" />
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <controls:LineChart Values="{Binding TempHistory}" Title="Chiptemperatur" Unit="°C" Height="160" Stroke="{StaticResource TempBrush}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- BENCHMARK -->
                    <TabItem Header="Benchmark">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel IsEnabled="{Binding IsIdle}" Width="470">
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Suchbereich" Style="{StaticResource SectionTitle}" Grid.ColumnSpan="4" />
                                            <TextBlock Grid.Row="1" Text="Frequenz Start / Max (MHz)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.StartFrequencyMhz}" Style="{StaticResource FieldBox}" Width="70" Margin="0,3,6,3" />
                                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Settings.MaxFrequencyMhz}" Style="{StaticResource FieldBox}" Width="70" />
                                            <TextBlock Grid.Row="2" Text="Frequenz-Schritt (MHz)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.FrequencyStepMhz}" Style="{StaticResource FieldBox}" Width="70" />
                                            <TextBlock Grid.Row="3" Text="Spannung Start / Max (mV)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.StartVoltageMv}" Style="{StaticResource FieldBox}" Width="70" Margin="0,3,6,3" />
                                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Settings.MaxVoltageMv}" Style="{StaticResource FieldBox}" Width="70" />
                                            <TextBlock Grid.Row="4" Text="Spannung Minimum (mV)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.MinVoltageMv}" Style="{StaticResource FieldBox}" Width="70" />
                                            <TextBlock Grid.Row="5" Text="Spannungs-Schritt (mV)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.VoltageStepMv}" Style="{StaticResource FieldBox}" Width="70" />
                                            <CheckBox Grid.Row="6" Grid.ColumnSpan="4" Margin="0,6,0,0" IsChecked="{Binding Settings.TryLowerVoltage}">
                                                <TextBlock TextWrapping="Wrap" Text="Pro Frequenz auch niedrigere Spannung testen (effizienter, dauert länger)" />
                                            </CheckBox>
                                            <Button Grid.Row="7" Grid.ColumnSpan="4" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Content="Auf Profilwerte zurücksetzen" Command="{Binding ResetToProfileCommand}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Messung &amp; Stabilität" Style="{StaticResource SectionTitle}" Grid.ColumnSpan="2" />
                                            <TextBlock Grid.Row="1" Text="Aufwärmzeit pro Schritt (s)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.WarmupSeconds}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="2" Text="Messdauer pro Schritt (s)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.MeasureSeconds}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="3" Text="Messintervall (s)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.SampleIntervalSeconds}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="4" Text="Mindestanzahl Messwerte" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.MinSamples}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="5" Text="Stabil ab Anteil der Soll-Hashrate (0,94 = 94 %)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.StabilityThreshold}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="6" Text="Max. Fehlerrate (%)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.MaxErrorPercent}" Style="{StaticResource FieldBox}" />
                                            <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Margin="0,6,0,0" IsChecked="{Binding Settings.RestartAfterApply}"
                                                      Content="Nach jeder Änderung neu starten (sauberere Messwerte)" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Sicherheitsgrenzen" Style="{StaticResource SectionTitle}" Grid.ColumnSpan="2" />
                                            <TextBlock Grid.Row="1" Text="Max. Chiptemperatur (°C)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.MaxChipTempC}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="2" Text="Max. VR-Temperatur (°C)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.MaxVrTempC}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="3" Text="Max. Leistung (W)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.MaxPowerW}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="4" Text="Min. Eingangsspannung (mV, leer = aus)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.MinInputVoltageMv, TargetNullValue=''}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="5" Text="Max. Eingangsspannung (mV, leer = aus)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.MaxInputVoltageMv, TargetNullValue=''}" Style="{StaticResource FieldBox}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Lüfter &amp; Abschluss" Style="{StaticResource SectionTitle}" />
                                            <ComboBox ItemsSource="{x:Static vm:Options.Fan}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.FanMode}" Margin="0,0,0,8" />
                                            <TextBlock Text="Nach dem Benchmark:" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{x:Static vm:Options.Restore}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.RestoreMode}" Margin="0,0,0,8" />
                                            <TextBlock Text="„Beste Einstellung“ bedeutet:" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{x:Static vm:Options.Ranking}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.RestoreRanking}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <DockPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" DockPanel.Dock="Top">
                                    <StackPanel>
                                        <TextBlock Text="Ablauf" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding EstimatedDurationText}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                                        <WrapPanel Margin="0,0,0,14">
                                            <Button Content="▶ Benchmark starten" Command="{Binding StartBenchmarkCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="⏯ Pause / Weiter" Command="{Binding TogglePauseCommand}" />
                                            <Button Content="■ Stopp" Command="{Binding StopBenchmarkCommand}" Style="{StaticResource DangerButton}" />
                                            <Button Content="Letzten Lauf fortsetzen" Command="{Binding ResumeBenchmarkCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding PhaseText}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StepText}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <TextBlock Text="Aktueller Schritt" Style="{StaticResource Muted}" />
                                        <ProgressBar Value="{Binding PhaseProgress}" Margin="0,4,0,10" />
                                        <TextBlock Text="Gesamt (Schätzung – endet oft früher)" Style="{StaticResource Muted}" />
                                        <ProgressBar Value="{Binding OverallProgress}" Margin="0,4,0,6" />
                                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" DockPanel.Dock="Top">
                                    <StackPanel>
                                        <TextBlock Text="Bisher beste Einstellung" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding BestSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0">
                                    <controls:LineChart Values="{Binding HashHistory}" Title="Hashrate (live)" Unit="GH/s" Stroke="{StaticResource AccentBrush}" MinHeight="140" />
                                </Border>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- ERGEBNISSE -->
                    <TabItem Header="Ergebnisse">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="Beste Einstellung nach:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{x:Static vm:Options.Ranking}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedRanking}" Width="250" />
                                        <TextBlock Text="Gewichtung Hashrate (nur Kompromiss):" VerticalAlignment="Center" Margin="16,0,8,0" />
                                        <Slider Minimum="0" Maximum="1" Width="140" Value="{Binding BalancedWeight}" VerticalAlignment="Center"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="0 % = nur Effizienz, 100 % = nur Hashrate" />
                                        <TextBlock Text="{Binding BalancedWeight, StringFormat=P0}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </WrapPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Beste anwenden" Command="{Binding ApplyBestCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Ausgewählte anwenden" Command="{Binding ApplyResultCommand}" />
                                            <Button Content="CSV exportieren" Command="{Binding ExportCsvCommand}" Margin="0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BestSummary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:Options.HeatmapMetrics}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding HeatmapMetric}" Width="220" />
                                        <TextBlock Text="Übersicht Frequenz × Spannung" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                                    </DockPanel>
                                    <controls:Heatmap Results="{Binding Results}" Metric="{Binding HeatmapMetric}" Highlight="{Binding BestResult}" Height="220" />
                                    <TextBlock Style="{StaticResource Muted}" Text="Orange = stabil (je kräftiger, desto besser) · × = instabil · Rot = Sicherheitsgrenze überschritten · Rahmen = beste Einstellung" />
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource CardBorderBrush}"
                                      HorizontalGridLinesBrush="{StaticResource CardBorderBrush}" RowHeight="26" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Status" SortMemberPath="Outcome">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Outcome, Converter={StaticResource OutcomeBrush}}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding OutcomeText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="MHz" Binding="{Binding FrequencyMhz}" />
                                    <DataGridTextColumn Header="mV" Binding="{Binding CoreVoltageMv}" />
                                    <DataGridTextColumn Header="GH/s" Binding="{Binding AvgHashRateGh, StringFormat=F1}" />
                                    <DataGridTextColumn Header="% Soll" Binding="{Binding HashRateRatio, StringFormat=P1}" />
                                    <DataGridTextColumn Header="W" Binding="{Binding AvgPowerW, StringFormat=F1}" />
                                    <DataGridTextColumn Header="J/TH" Binding="{Binding EfficiencyJth, StringFormat=F2}" />
                                    <DataGridTextColumn Header="Chip max °C" Binding="{Binding MaxChipTempC, StringFormat=F1}" />
                                    <DataGridTextColumn Header="VR max °C" Binding="{Binding MaxVrTempC, StringFormat=F1}" />
                                    <DataGridTextColumn Header="Fehler %" Binding="{Binding AvgErrorPercent, StringFormat=F2}" />
                                    <DataGridTextColumn Header="Messwerte" Binding="{Binding SampleCount}" />
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat=HH:mm}" />
                                    <DataGridTextColumn Header="Hinweis" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- PROTOKOLL -->
                    <TabItem Header="Protokoll">
                        <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" BorderThickness="0" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}"><Run Text="Daten: " /><Run Text="{Binding DataDirectory, Mode=OneWay}" /></TextBlock>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
