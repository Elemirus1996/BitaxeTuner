<Window xmlns:l="clr-namespace:BitaxeTuner.App.I18n"
        x:Class="BitaxeTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BitaxeTuner.App.ViewModels"
        xmlns:controls="clr-namespace:BitaxeTuner.App.Controls"
        xmlns:views="clr-namespace:BitaxeTuner.App.Views"
        Title="BitaxeTuner" Icon="Assets/app.ico" Height="920" Width="1400" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Background="{DynamicResource HeaderBrush}" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                        <TextBlock Text="₿" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BitaxeTuner" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VersionText}" Foreground="#9CA3AF" Margin="8,4,0,0" VerticalAlignment="Center"
                               ToolTip="{l:T 'Copyright © 2026 BitaxeTuner contributors · Freie Software unter der GNU GPL v3.0, ohne jede Gewähr · Quelltext, Lizenz (LICENSE.txt) und Drittanbieter-Hinweise (THIRD-PARTY-NOTICES.txt) im Programmordner und auf github.com/Elemirus1996/BitaxeTuner'}" />
                    <Button Content="{Binding UpdateText}" Command="{Binding InstallUpdateCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="14,0,6,0" Padding="10,3" VerticalAlignment="Center"
                            Visibility="{Binding UpdateText, Converter={StaticResource NullToVisibility}}" />
                    <Button Content="{l:T 'Was ist neu?'}" Command="{Binding OpenUpdateCommand}" Style="{StaticResource LinkButton}"
                            Foreground="#9CA3AF" Margin="0,4,0,0" VerticalAlignment="Center"
                            Visibility="{Binding UpdateText, Converter={StaticResource NullToVisibility}}" />
                    <Button Content="{l:T 'Nach Updates suchen'}" Command="{Binding CheckUpdatesNowCommand}" Style="{StaticResource LinkButton}"
                            Foreground="#9CA3AF" Margin="14,4,0,0" VerticalAlignment="Center"
                            Visibility="{Binding UpdateText, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{l:T 'Einstellungen'}" Click="OnSettingsClick" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="SshButton" Content="{l:T 'SSH-Terminal'}" Click="OnSshClick" Visibility="Collapsed"
                            ToolTip="{l:T 'Konsole auf deinem Server öffnen (ohne Passwort, Einrichtung unter Betriebsart …)'}" />
                    <Button Content="{l:T 'Betriebsart …'}" Click="OnModeClick"
                            ToolTip="{l:T 'Lokal (dieser PC) oder BitaxeTuner-Server (Raspberry Pi / Windows-Dienst / Docker) für 24/7-Betrieb'}" />
                    <Button Content="{l:T 'Dauertest …'}" Click="OnSoakBatchClick"
                            ToolTip="{l:T 'Dauertest für mehrere Miner auf einmal starten oder alle abbrechen'}" />
                    <Button Content="{l:T 'Einstellungen übertragen …'}" Click="OnCopySettingsClick"
                            ToolTip="{l:T 'Pool und Lüfter eines Miners auf andere übernehmen (ohne Frequenz/Spannung)'}" />
                    <Button Content="{l:T 'Bericht …'}" Click="OnReportClick"
                            ToolTip="{l:T 'Monats- und Jahresbericht: Energie, Kosten, Verfügbarkeit, Zuflüsse (Drucken/PDF, CSV)'}" />
                    <Button Content="{l:T 'Protokoll …'}" Click="OnJournalClick"
                            ToolTip="{l:T 'Dauerhaftes Protokoll: Frequenz/Spannung, Benchmark, Lüfter, Verbindungen (mindestens 30 Tage, filterbar)'}" />
                    <Button Content="{l:T 'Smart Plugs …'}" Click="OnSmartPlugsClick"
                            ToolTip="{l:T 'Shelly-Steckdosen für den echten Verbrauch an der Steckdose (nur messen, nie schalten)'}" />
                    <Button Content="{l:T 'Profile bearbeiten'}" Command="{Binding EditProfilesCommand}" />
                    <Button Content="{l:T 'Datenordner öffnen'}" Command="{Binding OpenDataDirectoryCommand}" ToolTip="{Binding DataDirectory}" />
                    <Button Content="GitHub" Command="{Binding OpenProjectPageCommand}" />
                    <Button Content="{l:T 'Lizenz'}" Click="OnLicenseClick" ToolTip="{l:T 'Lizenz, Gewährleistung und Hinweise zu enthaltenen Komponenten'}" />
                    <Button Content="{l:T '■ Alle stoppen'}" Command="{Binding StopAllCommand}" Style="{StaticResource DangerButton}" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Geräteliste: Gesamt · Miner · Netzwerk · Steuer (eine gemeinsame Liste aus config.json) -->
            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T 'Geräte'}" Style="{StaticResource SectionTitle}" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="{l:T 'Neues Gerät'}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="{l:T 'Name (optional)'}" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddDeviceCommand}" Margin="6,0,0,0" Width="34"
                                    Style="{StaticResource PrimaryButton}" IsDefault="True" ToolTip="{l:T 'Gerät hinzufügen'}" />
                            <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:T 'Host oder IP, z. B. 192.168.1.50 – zum Ausprobieren: sim oder sim:nerdqaxe-plusplus'}" />
                        </DockPanel>
                        <Button Content="{l:T 'Netzwerk durchsuchen'}" Command="{Binding ScanNetworkCommand}" Margin="0,0,0,6" />
                        <ProgressBar Value="{Binding ScanProgress}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6" />
                        <Button Content="{l:T 'Ausgewähltes Gerät entfernen'}" Command="{Binding RemoveDeviceCommand}" />
                    </StackPanel>

                    <ListBox x:Name="NavList" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnNavChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{l:T '● läuft'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"
                                                   Visibility="{Binding Device.IsRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PoolLinkButton}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Tag="{Binding PoolLink}" ToolTip="{Binding PoolLinkToolTip}" Click="OnPoolLinkClick"
                                                Visibility="{Binding PoolLink, Converter={StaticResource NullToVisibility}}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="14,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Gesamt, Netzwerk, Steuer: Überwachungsansicht (wird im Code zwischen hier und dem Geräte-Tab umgehängt) -->
            <ContentControl x:Name="MainContent" Grid.Column="2"
                            Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />

            <!-- Gerätedetails -->
            <Grid Grid.Column="2" DataContext="{Binding SelectedDevice}"
                  Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'Profil:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding Profile}" Width="260"
                                      DisplayMemberPath="Name" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                            <Button Content="{l:T 'Sichern'}" Command="{Binding BackupSettingsCommand}"
                                    ToolTip="{l:T 'Aktuelle Einstellungen des Miners sichern (Frequenz, Spannung, Lüfter, Pool)'}" />
                            <Button Content="{l:T 'Wiederherstellen …'}" Command="{Binding RestoreSettingsCommand}"
                                    ToolTip="{l:T 'Gesicherte Einstellungen auswählen und zurückspielen'}" />
                            <Button Content="{l:T 'Aktualisieren'}" Command="{Binding RefreshCommand}" />
                            <Button Content="{l:T 'Weboberfläche'}" Command="{Binding OpenWebUiCommand}" Margin="0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding ProfileNotes}" Foreground="{DynamicResource AccentDarkBrush}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding ProfileNotes, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl x:Name="DeviceTabs" SelectionChanged="OnDeviceTabChanged" Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="14">
                    <!-- ÜBERWACHUNG (BitaxeMonitor) -->
                    <TabItem Header="{l:T 'Überwachung'}">
                        <ContentControl x:Name="MonitorSlot" />
                    </TabItem>

                    <!-- LIVE -->
                    <TabItem Header="Live">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <UniformGrid Columns="4">
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="Hashrate" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Info.HashRateGh, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" GH/s" FontSize="13" /></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'erwartet '}" /><Run Text="{Binding Info.ExpectedHashRateGh, Converter={StaticResource Num}, ConverterParameter=F0, Mode=OneWay}" /><Run Text=" GH/s" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="{l:T 'Leistung / Effizienz'}" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Info.PowerW, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" W" FontSize="13" /></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding EfficiencyText, Mode=OneWay}" /><Run Text="{l:T ' J/TH'}" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="{l:T 'Chip / VR-Temperatur'}" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Info.MaxChipTempC, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" °C" FontSize="13" /></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="VR " /><Run Text="{Binding Info.VrTempC, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" °C" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}" Margin="0,0,0,10"><StackPanel>
                                        <TextBlock Text="{l:T 'Frequenz / Kernspannung'}" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Info.FrequencyMhz, Mode=OneWay}" /><Run Text="{l:T ' MHz'}" FontSize="13" /></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Info.CoreVoltageMv, Mode=OneWay}" /><Run Text="{l:T ' mV (ist '}" /><Run Text="{Binding Info.CoreVoltageActualMv, Converter={StaticResource Num}, ConverterParameter=F0, Mode=OneWay}" /><Run Text="{l:T ' mV)'}" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="{l:T 'Eingangsspannung'}" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Info.InputVoltageMv, Converter={StaticResource Num}, ConverterParameter=F0, Mode=OneWay}" /><Run Text="{l:T ' mV'}" FontSize="12" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="{l:T 'Lüfter'}" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Info.FanPercent, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text=" % · " FontSize="12" /><Run Text="{Binding Info.FanRpm, Converter={StaticResource Num}, Mode=OneWay}" /><Run Text="{l:T ' U/min'}" FontSize="12" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}"><StackPanel>
                                        <TextBlock Text="{l:T 'Shares (akzeptiert / abgelehnt)'}" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Info.SharesAccepted, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Info.SharesRejected, Mode=OneWay}" /><Run Text="{l:T ' · Pool-Diff '}" FontSize="12" /><Run Text="{Binding Info.PoolDifficultyText, Mode=OneWay}" FontSize="12" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Metric}" Margin="0,0,0,10"><StackPanel>
                                        <TextBlock Text="{l:T 'Fehlerrate (ASIC)'}" Style="{StaticResource Muted}" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Info.ErrorPercent, Converter={StaticResource Num}, ConverterParameter=F2, Mode=OneWay}" /><Run Text=" %" FontSize="12" /></TextBlock>
                                    </StackPanel></Border>
                                </UniformGrid>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Manuell einstellen'}" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{l:T 'Frequenz (MHz)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ManualFrequency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Width="80" Margin="0,3,16,3" />
                                            <TextBlock Text="{l:T 'Kernspannung (mV)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ManualVoltage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Width="80" Margin="0,3,16,3" />
                                            <Button Content="{l:T 'Anwenden …'}" Command="{Binding ApplyManualCommand}" Style="{StaticResource PrimaryButton}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="{l:T 'Vor dem Senden zeigt ein Dialog den aktuellen und den neuen Wert. Werte außerhalb der Profilgrenzen werden abgelehnt. Jede Änderung wird in history.db protokolliert und im Verlauf markiert.'}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="{l:T 'Lüfter des Miners'}" Style="{StaticResource FieldLabel}" />
                                            <RadioButton Content="{l:T 'Automatik, Ziel (°C)'}" IsChecked="{Binding FanAuto}" GroupName="MinerFan" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding FanTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Width="50" Margin="0,3,14,3" />
                                            <RadioButton Content="{l:T 'Manuell (%)'}" IsChecked="{Binding FanManual}" GroupName="MinerFan" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding FanManualPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Width="50" Margin="0,3,14,3" />
                                            <Button Content="{l:T 'Lüfter anwenden …'}" Command="{Binding ApplyFanCommand}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding FanCurrentText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <controls:LineChart Values="{Binding HashHistory}" Title="Hashrate" Unit="GH/s" Height="200" Stroke="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <controls:LineChart Values="{Binding TempHistory}" Title="{l:T 'Chiptemperatur'}" Unit="°C" Height="160" Stroke="{DynamicResource TempBrush}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- BENCHMARK -->
                    <TabItem Header="Benchmark">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel IsEnabled="{Binding IsIdle}" Width="470">
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{l:T 'Suchbereich'}" Style="{StaticResource SectionTitle}" Grid.ColumnSpan="4" />
                                            <TextBlock Grid.Row="1" Text="{l:T 'Frequenz Start / Max (MHz)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.StartFrequencyMhz}" Style="{StaticResource FieldBox}" Width="70" Margin="0,3,6,3" />
                                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Settings.MaxFrequencyMhz}" Style="{StaticResource FieldBox}" Width="70" />
                                            <TextBlock Grid.Row="2" Text="{l:T 'Frequenz-Schritt (MHz)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.FrequencyStepMhz}" Style="{StaticResource FieldBox}" Width="70" />
                                            <TextBlock Grid.Row="3" Text="{l:T 'Spannung Start / Max (mV)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.StartVoltageMv}" Style="{StaticResource FieldBox}" Width="70" Margin="0,3,6,3" />
                                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Settings.MaxVoltageMv}" Style="{StaticResource FieldBox}" Width="70" />
                                            <TextBlock Grid.Row="4" Text="{l:T 'Spannung Minimum (mV)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.MinVoltageMv}" Style="{StaticResource FieldBox}" Width="70" />
                                            <TextBlock Grid.Row="5" Text="{l:T 'Spannungs-Schritt (mV)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.VoltageStepMv}" Style="{StaticResource FieldBox}" Width="70" />
                                            <CheckBox Grid.Row="6" Grid.ColumnSpan="4" Margin="0,6,0,0" IsChecked="{Binding Settings.TryLowerVoltage}">
                                                <TextBlock TextWrapping="Wrap" Text="{l:T 'Pro Frequenz auch niedrigere Spannung testen (effizienter, dauert länger)'}" />
                                            </CheckBox>
                                            <Button Grid.Row="7" Grid.ColumnSpan="4" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Content="{l:T 'Auf Profilwerte zurücksetzen'}" Command="{Binding ResetToProfileCommand}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{l:T 'Messung &amp; Stabilität'}" Style="{StaticResource SectionTitle}" Grid.ColumnSpan="2" />
                                            <TextBlock Grid.Row="1" Text="{l:T 'Aufwärmzeit pro Schritt (s)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.WarmupSeconds}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="2" Text="{l:T 'Messdauer pro Schritt (s)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.MeasureSeconds}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="3" Text="{l:T 'Messintervall (s)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.SampleIntervalSeconds}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="4" Text="{l:T 'Mindestanzahl Messwerte'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.MinSamples}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="5" Text="{l:T 'Stabil ab Anteil der Soll-Hashrate (0,94 = 94 %)'}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.StabilityThreshold}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="6" Text="{l:T 'Max. Fehlerrate (%)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.MaxErrorPercent}" Style="{StaticResource FieldBox}" />
                                            <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Margin="0,6,0,0" IsChecked="{Binding Settings.RestartAfterApply}"
                                                      Content="{l:T 'Nach jeder Änderung neu starten (sauberere Messwerte)'}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{l:T 'Sicherheitsgrenzen'}" Style="{StaticResource SectionTitle}" Grid.ColumnSpan="2" />
                                            <TextBlock Grid.Row="1" Text="{l:T 'Max. Chiptemperatur (°C)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.MaxChipTempC}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="2" Text="{l:T 'Max. VR-Temperatur (°C)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.MaxVrTempC}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="3" Text="{l:T 'Max. Leistung (W)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.MaxPowerW}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="4" Text="{l:T 'Min. Eingangsspannung (mV, leer = aus)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.MinInputVoltageMv, TargetNullValue=''}" Style="{StaticResource FieldBox}" />
                                            <TextBlock Grid.Row="5" Text="{l:T 'Max. Eingangsspannung (mV, leer = aus)'}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.MaxInputVoltageMv, TargetNullValue=''}" Style="{StaticResource FieldBox}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'Lüfter &amp; Abschluss'}" Style="{StaticResource SectionTitle}" />
                                            <ComboBox ItemsSource="{x:Static vm:Options.Fan}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.FanMode}" Margin="0,0,0,8" />
                                            <TextBlock Text="{l:T 'Nach dem Benchmark:'}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{x:Static vm:Options.Restore}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.RestoreMode}" Margin="0,0,0,8" />
                                            <TextBlock Text="{l:T '„Beste Einstellung“ bedeutet:'}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{x:Static vm:Options.Ranking}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.RestoreRanking}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <DockPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" DockPanel.Dock="Top">
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Ablauf'}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding EstimatedDurationText}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                                        <WrapPanel Margin="0,0,0,14">
                                            <Button Content="{l:T '▶ Benchmark starten'}" Command="{Binding StartBenchmarkCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="{l:T '⏯ Pause / Weiter'}" Command="{Binding TogglePauseCommand}" />
                                            <Button Content="{l:T '■ Stopp'}" Command="{Binding StopBenchmarkCommand}" Style="{StaticResource DangerButton}" />
                                            <Button Content="{l:T 'Letzten Lauf fortsetzen'}" Command="{Binding ResumeBenchmarkCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding PhaseText}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StepText}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <TextBlock Text="{l:T 'Aktueller Schritt'}" Style="{StaticResource Muted}" />
                                        <ProgressBar Value="{Binding PhaseProgress}" Margin="0,4,0,10" />
                                        <TextBlock Text="{l:T 'Gesamt (Schätzung – endet oft früher)'}" Style="{StaticResource Muted}" />
                                        <ProgressBar Value="{Binding OverallProgress}" Margin="0,4,0,6" />
                                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" DockPanel.Dock="Top">
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Bisher beste Einstellung'}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding BestSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0">
                                    <controls:LineChart Values="{Binding HashHistory}" Title="{l:T 'Hashrate (live)'}" Unit="GH/s" Stroke="{DynamicResource AccentBrush}" MinHeight="140" />
                                </Border>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- ERGEBNISSE -->
                    <TabItem Header="{l:T 'Ergebnisse'}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="{l:T 'Beste Einstellung nach:'}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{x:Static vm:Options.Ranking}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedRanking}" Width="250" />
                                        <TextBlock Text="{l:T 'Gewichtung Hashrate (nur Kompromiss):'}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                        <Slider Minimum="0" Maximum="1" Width="140" Value="{Binding BalancedWeight}" VerticalAlignment="Center"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="{l:T '0 % = nur Effizienz, 100 % = nur Hashrate'}" />
                                        <TextBlock Text="{Binding BalancedWeight, StringFormat=P0}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </WrapPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{l:T 'Beste anwenden'}" Command="{Binding ApplyBestCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="{l:T 'Ausgewählte anwenden'}" Command="{Binding ApplyResultCommand}" />
                                            <Button Content="{l:T 'In Automatik speichern …'}" Command="{Binding SaveResultAsPresetCommand}"
                                                    ToolTip="{l:T 'Ausgewähltes Ergebnis als Voreinstellung für Zeitplan und Strompreis-Automatik speichern'}" />
                                            <Button Content="{l:T 'CSV exportieren'}" Command="{Binding ExportCsvCommand}" Margin="0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BestSummary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:Options.HeatmapMetrics}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding HeatmapMetric}" Width="220" />
                                        <TextBlock Text="{l:T 'Übersicht Frequenz × Spannung'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                                    </DockPanel>
                                    <controls:Heatmap Results="{Binding Results}" Metric="{Binding HeatmapMetric}" Highlight="{Binding BestResult}" Height="220" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Orange = stabil (je kräftiger, desto besser) · × = instabil · Rot = Sicherheitsgrenze überschritten · Rahmen = beste Einstellung'}" />
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{DynamicResource CardBorderBrush}"
                                      HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}" RowHeight="26" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{l:T 'Status'}" SortMemberPath="Outcome">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Outcome, Converter={StaticResource OutcomeBrush}}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding OutcomeText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="MHz" Binding="{Binding FrequencyMhz}" />
                                    <DataGridTextColumn Header="mV" Binding="{Binding CoreVoltageMv}" />
                                    <DataGridTextColumn Header="GH/s" Binding="{Binding AvgHashRateGh, StringFormat=F1}" />
                                    <DataGridTextColumn Header="{l:T '% Soll'}" Binding="{Binding HashRateRatio, StringFormat=P1}" />
                                    <DataGridTextColumn Header="W" Binding="{Binding AvgPowerW, StringFormat=F1}" />
                                    <DataGridTextColumn Header="J/TH" Binding="{Binding EfficiencyJth, StringFormat=F2}" />
                                    <DataGridTextColumn Header="{l:T 'Chip max °C'}" Binding="{Binding MaxChipTempC, StringFormat=F1}" />
                                    <DataGridTextColumn Header="{l:T 'VR max °C'}" Binding="{Binding MaxVrTempC, StringFormat=F1}" />
                                    <DataGridTextColumn Header="{l:T 'Fehler %'}" Binding="{Binding AvgErrorPercent, StringFormat=F2}" />
                                    <DataGridTextColumn Header="{l:T 'Messwerte'}" Binding="{Binding SampleCount}" />
                                    <DataGridTextColumn Header="{l:T 'Zeit'}" Binding="{Binding Timestamp, StringFormat=HH:mm}" />
                                    <DataGridTextColumn Header="{l:T 'Hinweis'}" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- VORHER/NACHHER -->
                    <TabItem Header="{l:T 'Vorher/Nachher'}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{l:T 'Aktualisieren'}" Command="{Binding RefreshComparisonsCommand}" Margin="0" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{l:T 'Jede Tuning-Änderung aus history.db: Mittelwerte 60 min vorher und 60 min nachher (die ersten 5 min nach der Änderung zählen als Anlaufphase).'}" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Comparisons}" IsReadOnly="True" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T 'Zeit'}" Binding="{Binding Time, StringFormat='dd.MM. HH:mm', ConverterCulture='de-DE'}" Width="95" />
                                    <DataGridTextColumn Header="{l:T 'Quelle'}" Binding="{Binding Source}" Width="120" />
                                    <DataGridTextColumn Header="{l:T 'Änderung'}" Binding="{Binding Change}" Width="210" />
                                    <DataGridTextColumn Header="{l:T 'Vorher (Ø 60 min)'}" Binding="{Binding BeforeText}" Width="260" />
                                    <DataGridTextColumn Header="{l:T 'Nachher (Ø 60 min)'}" Binding="{Binding AfterText}" Width="260" />
                                    <DataGridTextColumn Header="{l:T 'Differenz'}" Binding="{Binding DeltaText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- AUTOMATIK: Voreinstellungen, Temperaturschutz, Zeitplan/Strompreis, Dauertest -->
                    <TabItem Header="{l:T 'Automatik'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AutomationStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SoakStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding SoakStatus, Converter={StaticResource NullToVisibility}}" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="{l:T 'Regeln handeln erst nach ausdrücklicher Freigabe. Jede Änderung an einer Regel hebt die Freigabe auf. Automatische Änderungen werden in history.db protokolliert (Quelle „Automatik“), im Verlauf markiert und per Push gemeldet (Einstellungen → „Watchdog, Firmware, Automatik“).'}" />
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <!-- Voreinstellungen -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Voreinstellungen'}" Style="{StaticResource SectionTitle}" />
                                                <DataGrid ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" IsReadOnly="True" Height="120">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="{l:T 'Name'}" Binding="{Binding Name}" Width="*" />
                                                        <DataGridTextColumn Header="MHz" Binding="{Binding FrequencyMhz}" Width="70" />
                                                        <DataGridTextColumn Header="mV" Binding="{Binding CoreVoltageMv}" Width="70" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <DockPanel Margin="0,8,0,0">
                                                    <Button DockPanel.Dock="Right" Content="{l:T 'Entfernen'}" Command="{Binding RemovePresetCommand}" Margin="8,0,0,0" />
                                                    <Button DockPanel.Dock="Right" Content="{l:T 'Aktuelle Werte speichern'}" Command="{Binding AddPresetFromCurrentCommand}" Margin="8,0,0,0" />
                                                    <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T 'Name, z. B. Hashrate, Effizienz, Nacht'}" />
                                                </DockPanel>
                                                <Button Content="{l:T '„Hashrate“ und „Effizienz“ aus dem letzten Benchmark übernehmen'}" Command="{Binding AddPresetsFromBenchmarkCommand}"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Temperaturschutz -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Temperaturschutz'}" Style="{StaticResource SectionTitle}" />
                                                <CheckBox Content="{l:T 'Eingeschaltet'}" IsChecked="{Binding ThermalGuard.Enabled}" Margin="0,0,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                    <TextBlock Text="{l:T 'Max. Chiptemperatur (°C)'}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Column="1" Text="{Binding ThermalGuard.MaxChipTempC}" Style="{StaticResource FieldBox}" />
                                                    <TextBlock Grid.Row="1" Text="{l:T 'Max. VR-Temperatur (°C)'}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ThermalGuard.MaxVrTempC}" Style="{StaticResource FieldBox}" />
                                                    <TextBlock Grid.Row="2" Text="{l:T 'Durchgehend überschritten (min)'}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ThermalGuard.Minutes}" Style="{StaticResource FieldBox}" />
                                                    <TextBlock Grid.Row="3" Text="{l:T 'Frequenz senken um (MHz)'}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ThermalGuard.StepMhz}" Style="{StaticResource FieldBox}" />
                                                    <TextBlock Grid.Row="4" Text="{l:T 'Nie unter (MHz)'}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ThermalGuard.MinFrequencyMhz}" Style="{StaticResource FieldBox}" />
                                                    <CheckBox Grid.Row="5" Content="{l:T 'Zurück, wenn kühl – nach (min):'}" IsChecked="{Binding ThermalGuard.Recover}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ThermalGuard.RecoverMinutes}" Style="{StaticResource FieldBox}" />
                                                </Grid>
                                                <Button Content="{l:T 'Speichern und freigeben …'}" Command="{Binding ApproveThermalGuardCommand}" Style="{StaticResource PrimaryButton}"
                                                        HorizontalAlignment="Left" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <!-- Zeitplan / Strompreis -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Zeitplan / Strompreis'}" Style="{StaticResource SectionTitle}" />
                                                <CheckBox Content="{l:T 'Eingeschaltet'}" IsChecked="{Binding Schedule.Enabled}" Margin="0,0,0,8" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <RadioButton Content="{l:T 'Zeitplan'}" IsChecked="{Binding ScheduleIsTime}" Margin="0,0,16,0"
                                                                 Foreground="{DynamicResource TextBrush}" GroupName="Mode" />
                                                    <RadioButton Content="{l:T 'Strompreis'}" IsChecked="{Binding ScheduleIsPrice}" Foreground="{DynamicResource TextBrush}" GroupName="Mode" />
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding ScheduleIsTime, Converter={StaticResource BoolToVisibility}}">
                                                    <DataGrid ItemsSource="{Binding ScheduleEntries}" SelectedItem="{Binding SelectedScheduleEntry}" Height="130"
                                                              IsReadOnly="False" CanUserAddRows="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="{l:T 'Tage (täglich, Mo-Fr, Sa,So)'}" Binding="{Binding DaysText, UpdateSourceTrigger=LostFocus}" Width="*" />
                                                            <DataGridTextColumn Header="{l:T 'Von (h)'}" Binding="{Binding FromHour}" Width="60" />
                                                            <DataGridTextColumn Header="{l:T 'Bis (h)'}" Binding="{Binding ToHour}" Width="60" />
                                                            <DataGridTextColumn Header="{l:T 'Voreinstellung'}" Binding="{Binding Preset}" Width="110" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Content="{l:T 'Zeile hinzufügen'}" Command="{Binding AddScheduleEntryCommand}" />
                                                        <Button Content="{l:T 'Zeile entfernen'}" Command="{Binding RemoveScheduleEntryCommand}" />
                                                    </StackPanel>
                                                    <DockPanel Margin="0,8,0,0">
                                                        <TextBlock Text="{l:T 'Sonst (leer = nichts ändern):'}" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Text="{Binding Schedule.DefaultPreset}" />
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Text="{l:T 'Erste passende Zeile gilt. „Bis“ ist ausschließlich; 22–6 läuft über Mitternacht (der Morgen zählt zum Vortag).'}" />
                                                </StackPanel>

                                                <Grid Visibility="{Binding ScheduleIsPrice, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                    <TextBlock Text="{l:T 'Schwelle (ct/kWh)'}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Column="1" Text="{Binding Schedule.ThresholdCt}" Style="{StaticResource FieldBox}" />
                                                    <TextBlock Grid.Row="1" Text="{l:T 'Günstig (≤ Schwelle) → Voreinstellung'}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Schedule.CheapPreset}" Width="130" Margin="0,3" />
                                                    <TextBlock Grid.Row="2" Text="{l:T 'Teuer → Voreinstellung'}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Schedule.ExpensivePreset}" Width="130" Margin="0,3" />
                                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Text="{l:T 'Preisquelle in Einstellungen → Strompreis. aWATTar liefert den Börsenpreis ohne Netzentgelte/Steuern, Tibber den Endpreis – die Schwelle entsprechend wählen.'}" />
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="{l:T 'Speichern'}" Command="{Binding SaveAutomationCommand}" />
                                                    <Button Content="{l:T 'Speichern und freigeben …'}" Command="{Binding ApproveScheduleCommand}" Style="{StaticResource PrimaryButton}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Dauertest -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Dauertest der aktuellen Einstellung'}" Style="{StaticResource SectionTitle}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{l:T 'Dauer'}" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding SoakHourOptions}" SelectedItem="{Binding SoakHours}" Width="70" Margin="0,0,6,0" />
                                                    <TextBlock Text="h" Style="{StaticResource FieldLabel}" />
                                                    <Button Content="{l:T 'Starten …'}" Command="{Binding StartSoakCommand}" Style="{StaticResource PrimaryButton}" />
                                                    <Button Content="{l:T 'Abbrechen'}" Command="{Binding StopSoakCommand}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           Text="{l:T 'Prüft über Stunden: Hashrate (Ø 15 min, mind. 93 % der Soll-Hashrate), Fehlerrate, Temperaturen gegen die Profilgrenzen, Erreichbarkeit. Ändert nichts am Miner. Läuft nach einem Neustart der App weiter. Bei einem Fehler schlägt die App die nächstniedrigere stabile Einstellung aus dem letzten Benchmark vor – angewendet wird nur nach Bestätigung.'}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- MINER-LOGS (live über ws://<host>/api/ws, Puffer über /api/system/logs) -->
                    <TabItem x:Name="LogsTab" Header="{l:T 'Miner-Logs'}">
                        <DockPanel DataContext="{Binding Logs}">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Command="{Binding ToggleLiveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="120">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{l:T '▶ Live starten'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                            <Setter Property="Text" Value="{l:T '■ Live stoppen'}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button Content="{l:T 'Bisherigen Puffer laden'}" Command="{Binding LoadBufferCommand}"
                                        ToolTip="{l:T 'Log seit dem letzten Neustart des Miners (GET /api/system/logs, einige 100 KB)'}" />
                                <TextBox Width="180" Margin="0,0,8,0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{l:T 'Filter nach Text oder Modul (z. B. asic_result, stratum, fan)'}" />
                                <CheckBox Content="{l:T 'Fehler'}" IsChecked="{Binding ShowErrors}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Warnungen'}" IsChecked="{Binding ShowWarnings}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Content="Info" IsChecked="{Binding ShowInfo}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Content="Debug" IsChecked="{Binding ShowDebug}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <CheckBox Content="{l:T 'Auto-Scroll'}" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Anhalten'}" IsChecked="{Binding Paused}" VerticalAlignment="Center" Margin="0,0,16,0"
                                          ToolTip="{l:T 'Anzeige einfrieren – neue Zeilen werden gesammelt und danach angehängt'}" />
                                <Button Content="{l:T 'Leeren'}" Command="{Binding ClearCommand}" />
                                <Button Content="{l:T 'Speichern …'}" Command="{Binding SaveCommand}" Margin="0" />
                            </WrapPanel>
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Categories}" Margin="0,0,0,6"
                                          ToolTip="{l:T 'Kategorien ein-/ausblenden – kombinierbar mit Level und Textfilter'}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,6">
                                <Run Text="{l:T 'Status: '}" /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                <Run Text="{l:T ' · Die Verbindung ist nur offen, solange dieser Tab sichtbar ist (der Miner hat nur wenige WebSocket-Plätze).'}" />
                            </TextBlock>
                            <ListBox x:Name="MinerLogList" ItemsSource="{Binding View}" FontFamily="Consolas" FontSize="12"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True" Background="{DynamicResource FieldBrush}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="6,1" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Message}">
                                            <Run Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                                            <Run Text="{Binding LevelText, Mode=OneWay}" FontWeight="Bold" />
                                            <Run Text="{Binding Tag, Mode=OneWay}" Foreground="{DynamicResource InfoBrush}" />
                                            <Run Text="{Binding Message, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <!-- PROTOKOLL -->
                    <TabItem Header="{l:T 'App-Protokoll'}">
                        <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" BorderThickness="0" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}"><Run Text="{l:T 'Daten: '}" /><Run Text="{Binding DataDirectory, Mode=OneWay}" /></TextBlock>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
