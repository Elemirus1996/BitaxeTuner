<UserControl x:Class="BitaxeTuner.App.Tax.Views.TaxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BitaxeTuner.App.Tax.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:TaxViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Language="de-DE">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Adresse hinzufügen -->
        <Border Grid.Row="0" Style="{StaticResource Tile}">
            <StackPanel>
                <TextBlock Text="WALLET-ADRESSE HINZUFÜGEN" Style="{StaticResource TileLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="340" Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="bc1…, 1…, bitcoincash:q… oder q…"/>
                    <ComboBox Width="110" Margin="8,0,0,0" ItemsSource="{Binding AvailableCoins}"
                              SelectedItem="{Binding NewCoin}"/>
                    <TextBox Width="180" Margin="8,0,0,0" Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Anzeigename, z. B. Gamma 603"/>
                    <Button Content="Hinzufügen" Margin="8,0,0,0" Command="{Binding AddWalletCommand}"/>
                    <Button Content="Aus Minern übernehmen" Margin="8,0,0,0" Command="{Binding ImportFromMinersCommand}"
                            ToolTip="Adressen aus Einstellungen bzw. Stratum-User aller Miner übernehmen"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Überwachte Wallets -->
        <Border Grid.Row="1" Style="{StaticResource Tile}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ÜBERWACHTE WALLETS (Label und Coin sind editierbar)"
                           Style="{StaticResource TileLabel}"/>
                <Button DockPanel.Dock="Right" Content="Entfernen" VerticalAlignment="Top" Margin="8,0,0,0"
                        Command="{Binding RemoveWalletCommand}"/>
                <DataGrid x:Name="WalletGrid" MaxHeight="140" ItemsSource="{Binding Wallets}"
                          SelectedItem="{Binding SelectedWallet}" RowEditEnding="WalletGrid_RowEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="180"/>
                        <DataGridComboBoxColumn Header="Coin" SelectedItemBinding="{Binding Coin}" Width="90"
                                                x:Name="CoinColumn"/>
                        <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Quelle" Binding="{Binding SourceDeviceHost}" Width="130" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Zuflüsse und Verkäufe -->
        <Border Grid.Row="2" Style="{StaticResource Tile}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Zuflüsse" Command="{Binding ShowRewardsCommand}" Padding="12,4"/>
                    <Button Content="Verkäufe / Haltefrist" Command="{Binding ShowSalesCommand}" Padding="12,4" Margin="6,0,0,0"/>
                </StackPanel>

                <Grid>
                    <!-- Zuflüsse -->
                    <DockPanel Visibility="{Binding ShowRewards, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Top" Text="DOKUMENTIERTE ZUFLÜSSE (EUR-Kurs und Notiz editierbar)"
                                   Style="{StaticResource TileLabel}"/>
                        <DataGrid x:Name="RewardGrid" ItemsSource="{Binding Rewards}" SelectedItem="{Binding SelectedReward}"
                                  RowEditEnding="RewardGrid_RowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum/Zeit" Binding="{Binding ReceivedAtLocal, StringFormat='dd.MM.yyyy HH:mm', ConverterCulture='de-DE'}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Coin" Binding="{Binding CoinSymbol}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Wallet" Binding="{Binding WalletLabel}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Menge" Binding="{Binding Amount, StringFormat='0.00000000', ConverterCulture='de-DE'}" Width="105" IsReadOnly="True"/>
                                <DataGridTextColumn Header="EUR-Kurs" Binding="{Binding EurPriceAtReceipt, StringFormat='N2', ConverterCulture='de-DE', TargetNullValue=''}" Width="90"/>
                                <DataGridTextColumn Header="EUR-Wert" Binding="{Binding EurValue, StringFormat='N2', ConverterCulture='de-DE'}" Width="85" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Rest" Binding="{Binding Remaining, StringFormat='0.00000000', ConverterCulture='de-DE'}" Width="105" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Frei ab" Binding="{Binding TaxFreeFrom, StringFormat='dd.MM.yyyy', ConverterCulture='de-DE'}" Width="85" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Haltefrist" Binding="{Binding HoldingStatus}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Kursquelle" Binding="{Binding PriceSource}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Notiz" Binding="{Binding Note}" Width="180"/>
                                <DataGridTextColumn Header="TXID" Binding="{Binding TxId}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Verkäufe -->
                    <DockPanel Visibility="{Binding ShowSales, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Top" Text="VERKAUF ERFASSEN (FIFO, älteste Zuflüsse zuerst)"
                                   Style="{StaticResource TileLabel}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <DatePicker Width="120" SelectedDate="{Binding NewSaleDate}"/>
                            <ComboBox Width="110" Margin="8,0,0,0" ItemsSource="{Binding AvailableCoins}"
                                      SelectedItem="{Binding NewSaleCoin}"/>
                            <TextBox Width="130" Margin="8,0,0,0" Text="{Binding NewSaleAmount, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Menge in BTC bzw. BCH, z. B. 0,125"/>
                            <TextBox Width="110" Margin="8,0,0,0" Text="{Binding NewSaleProceeds, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Erlös in EUR; bei Tausch der Marktwert der Gegenleistung"/>
                            <TextBox Width="200" Margin="8,0,0,0" Text="{Binding NewSaleNote, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Notiz, z. B. Börse oder Zweck"/>
                            <Button Content="Erfassen" Margin="8,0,0,0" Command="{Binding AddDisposalCommand}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Felder: Datum · Coin · Menge · Erlös in EUR · Notiz"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,-6,0,8"/>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Verkauf löschen" Command="{Binding RemoveDisposalCommand}"/>
                            <Button Content="Verkäufe exportieren" Margin="8,0,0,0" Command="{Binding ExportDisposalsCommand}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Disposals}" SelectedItem="{Binding SelectedDisposal}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" Binding="{Binding SoldAtLocal, StringFormat='dd.MM.yyyy', ConverterCulture='de-DE'}" Width="90"/>
                                <DataGridTextColumn Header="Coin" Binding="{Binding CoinSymbol}" Width="50"/>
                                <DataGridTextColumn Header="Menge" Binding="{Binding Amount, StringFormat='0.00000000', ConverterCulture='de-DE'}" Width="105"/>
                                <DataGridTextColumn Header="Erlös €" Binding="{Binding ProceedsEur, StringFormat='N2', ConverterCulture='de-DE'}" Width="90"/>
                                <DataGridTextColumn Header="Anschaffung €" Binding="{Binding CostBasisEur, StringFormat='N2', ConverterCulture='de-DE'}" Width="100"/>
                                <DataGridTextColumn Header="Haltefristfrei" Binding="{Binding TaxFreeAmount, StringFormat='0.00000000', ConverterCulture='de-DE'}" Width="105"/>
                                <DataGridTextColumn Header="Steuerpfl. Gewinn €" Binding="{Binding TaxableGainEur, StringFormat='N2', ConverterCulture='de-DE'}" Width="130"/>
                                <DataGridTextColumn Header="Hinweis" Binding="{Binding Hint}" Width="220"/>
                                <DataGridTextColumn Header="Notiz" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Fußzeile -->
        <Border Grid.Row="3" Style="{StaticResource Tile}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Eintrag entfernen" Command="{Binding RemoveRewardCommand}"
                            ToolTip="Nur für Eingänge, die kein Mining-Ertrag sind. Die TXID wird danach ignoriert."/>
                    <Button Content="Jetzt prüfen" Margin="8,0,0,0" Command="{Binding RefreshNowCommand}"/>
                    <Button Content="CSV exportieren" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding YearSummary}" Foreground="{DynamicResource WarnBrush}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SalesSummary}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
