# BitaxeTuner: USB-Stick für Sicherungen automatisch einbinden (erste Partition mit FAT32, exFAT oder ext4)
# 0.9.16: auch Sticks ohne Partitionstabelle (Dateisystem direkt auf dem ganzen Gerät, „Superfloppy“, z. B. von Windows
# formatiert). Ein Stick mit Partitionen hat auf dem ganzen Gerät kein Dateisystem und wird deshalb nicht doppelt erfasst.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition|disk", ENV{ID_BUS}=="usb", ENV{ID_FS_TYPE}=="vfat|exfat|ext4", TAG+="systemd", ENV{SYSTEMD_WANTS}+="bitaxetuner-usb@%k.service"
